classDiagram
    class Customer {
        +String name
        +Transaction currentTransaction
        +List~Transaction~ pastTransactions
        +getPastTransaction()
        +order()
    }

    class FoodItem {
        +String name
        +Float price
        +String category
        +Float rating
    }

    class Collection {
        +String name
        +List~FoodItem~ items
        +addItem()
        +removeItem()
    }

    class Transaction {
        +List~FoodItem~ items
        +Float totalCost
        +addItem()
        +removeItem()
        +getTotalCost()
    }

    Customer "1" --> "0..1" Transaction : currentTransaction
    Customer "1" --> "0..*" Transaction : pastTransactions
    Transaction "1" o-- "1..*" FoodItem : items
    Collection "1" o-- "0..*" FoodItem : items
